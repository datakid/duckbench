{
  "name": "duckbench-desktop",
  "version": "2.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:web": "node scripts/prepare.mjs",
    "icons": "tauri icon app-icon.svg",
    "dev": "tauri dev",
    "build": "tauri build",
    "check": "node scripts/prepare.mjs && cd src-tauri && cargo test",
    "prepare:native": "node scripts/prepare.mjs --native",
    "dev:native": "tauri dev --features native-duckdb --config src-tauri/tauri.native.conf.json",
    "build:native": "tauri build --features native-duckdb --config src-tauri/tauri.native.conf.json",
    "test:native-js": "node --test scripts/native-adapter.test.mjs",
    "check:native": "node scripts/prepare.mjs --native && node --test scripts/native-adapter.test.mjs && cd src-tauri && cargo test --features native-duckdb"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0",
    "esbuild": "^0.25.0"
  },
  "optionalDependencies": {
    "@tauri-apps/plugin-updater": "^2",
    "@tauri-apps/plugin-process": "^2"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.33.1-dev114.0",
    "hyparquet": "^1.31.1",
    "hyparquet-compressors": "^1.1.1",
    "hyparquet-writer": "^0.5.0"
  },
  "engines": {
    "node": ">=18"
  }
}
