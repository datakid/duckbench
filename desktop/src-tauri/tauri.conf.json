{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Duckbench",
  "version": "2.2.0",
  "identifier": "app.duckbench.desktop",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "node scripts/prepare.mjs",
    "beforeBuildCommand": "node scripts/prepare.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Duckbench",
        "url": "index.html",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "dragDropEnabled": false,
        "backgroundColor": "#111111"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Local data-prep workbench powered by DuckDB",
    "longDescription": "Clean, reshape, join and export CSV, Excel, JSON and Parquet files on your own computer. Visual steps and SQL run locally with DuckDB; nothing is uploaded.",
    "copyright": "Duckbench",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    },
    "linux": {
      "deb": { "section": "science" }
    }
  }
}
